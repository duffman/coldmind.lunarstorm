{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "application.main.ts",
    "common",
    "views",
    "services"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
