node_modules
# Fix: `dist` ignored the directory, so the prebuilt dist/vcl.js that
# lunarstorm-pipeline embeds (src/frontend.rs) was never tracked and a fresh
# clone did not compile. Decision: ignore the contents and re-include vcl.js.
dist/*
!dist/vcl.js
dist-ssr
*.local

