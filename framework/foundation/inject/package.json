{
  "name": "@coldmind/inject",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "sideEffects": [
    "./src/core/cminject.decorators.ts",
    "./dist/core/cminject.decorators.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/cminject.core.d.ts",
      "bun": "./src/core/cminject.core.ts",
      "default": "./dist/core/cminject.core.js"
    },
    "./server": {
      "types": "./dist/server/cminject.server.d.ts",
      "bun": "./src/server/cminject.server.ts",
      "default": "./dist/server/cminject.server.js"
    },
    "./hot": {
      "types": "./dist/cminject.hot.d.ts",
      "bun": "./src/cminject.hot.ts",
      "default": "./dist/cminject.hot.js"
    },
    "./inspect": {
      "types": "./dist/cminject.inspect.d.ts",
      "bun": "./src/cminject.inspect.ts",
      "default": "./dist/cminject.inspect.js"
    },
    "./react": {
      "types": "./dist/cminject.react.d.ts",
      "bun": "./src/cminject.react.ts",
      "default": "./dist/cminject.react.js"
    },
    "./testing": {
      "types": "./dist/cminject.testing.d.ts",
      "bun": "./src/cminject.testing.ts",
      "default": "./dist/cminject.testing.js"
    },
    "./contracts": {
      "types": "./dist/core/cminject.contracts.d.ts",
      "bun": "./src/core/cminject.contracts.ts",
      "default": "./dist/core/cminject.contracts.js"
    },
    "./token": {
      "types": "./dist/core/cminject.token.d.ts",
      "bun": "./src/core/cminject.token.ts",
      "default": "./dist/core/cminject.token.js"
    },
    "./errors": {
      "types": "./dist/core/cminject.errors.d.ts",
      "bun": "./src/core/cminject.errors.ts",
      "default": "./dist/core/cminject.errors.js"
    },
    "./graph": {
      "types": "./dist/core/cminject.graph.d.ts",
      "bun": "./src/core/cminject.graph.ts",
      "default": "./dist/core/cminject.graph.js"
    },
    "./decorators": {
      "types": "./dist/core/cminject.decorators.d.ts",
      "bun": "./src/core/cminject.decorators.ts",
      "default": "./dist/core/cminject.decorators.js"
    },
    "./container": {
      "types": "./dist/core/cminject.container.d.ts",
      "bun": "./src/core/cminject.container.ts",
      "default": "./dist/core/cminject.container.js"
    },
    "./module": {
      "types": "./dist/core/cminject.module.d.ts",
      "bun": "./src/core/cminject.module.ts",
      "default": "./dist/core/cminject.module.js"
    },
    "./lazy": {
      "types": "./dist/core/cminject.lazy.d.ts",
      "bun": "./src/core/cminject.lazy.ts",
      "default": "./dist/core/cminject.lazy.js"
    },
    "./internal/async": {
      "types": "./dist/core/cminject.async.d.ts",
      "bun": "./src/core/cminject.async.ts",
      "default": "./dist/core/cminject.async.js"
    },
    "./internal/binding": {
      "types": "./dist/core/cminject.binding.d.ts",
      "bun": "./src/core/cminject.binding.ts",
      "default": "./dist/core/cminject.binding.js"
    },
    "./internal/view": {
      "types": "./dist/core/cminject.view.d.ts",
      "bun": "./src/core/cminject.view.ts",
      "default": "./dist/core/cminject.view.js"
    },
    "./internal/observe": {
      "types": "./dist/core/cminject.observe.d.ts",
      "bun": "./src/core/cminject.observe.ts",
      "default": "./dist/core/cminject.observe.js"
    },
    "./internal/construction": {
      "types": "./dist/core/cminject.construction.d.ts",
      "bun": "./src/core/cminject.construction.ts",
      "default": "./dist/core/cminject.construction.js"
    },
    "./internal/resolution": {
      "types": "./dist/core/cminject.resolution.d.ts",
      "bun": "./src/core/cminject.resolution.ts",
      "default": "./dist/core/cminject.resolution.js"
    },
    "./internal/mutation": {
      "types": "./dist/core/cminject.mutation.d.ts",
      "bun": "./src/core/cminject.mutation.ts",
      "default": "./dist/core/cminject.mutation.js"
    },
    "./internal/host": {
      "types": "./dist/core/cminject.host.d.ts",
      "bun": "./src/core/cminject.host.ts",
      "default": "./dist/core/cminject.host.js"
    },
    "./internal/server/context": {
      "types": "./dist/server/cminject.context.d.ts",
      "bun": "./src/server/cminject.context.ts",
      "default": "./dist/server/cminject.context.js"
    },
    "./internal/server/runtime": {
      "types": "./dist/server/cminject.runtime.d.ts",
      "bun": "./src/server/cminject.runtime.ts",
      "default": "./dist/server/cminject.runtime.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "check:browser": "bun scripts/check-browser.ts",
    "test": "bun run test:bun && bun run test:bun:legacy && bun run test:react",
    "test:react": "INJECT_EXPECT_BUN=1 CMINJECT_EXPECT_RUNTIME=bun bun node_modules/vitest/vitest.mjs run --config vitest.react.config.ts",
    "test:types": "node node_modules/vitest/vitest.mjs run --typecheck.only --config vitest.types.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test:bun": "CMINJECT_EXPECT_RUNTIME=bun bun node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/bun/core tests/bun/standard tests/bun/static tests/bun/server tests/bun/docs",
    "test:bun:legacy": "cd tests/bun/legacy && CMINJECT_EXPECT_RUNTIME=bun bun ../../../node_modules/vitest/vitest.mjs run --config ../../../vitest.config.ts tests/bun/legacy",
    "test:node": "CMINJECT_EXPECT_RUNTIME=node node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:coverage": "CMINJECT_COVERAGE=1 CMINJECT_EXPECT_RUNTIME=node node node_modules/vitest/vitest.mjs run --config vitest.config.ts --coverage",
    "check:imports": "bun scripts/check-imports.ts",
    "test:dist": "node --test tests/node/*.test.mjs",
    "docs:api": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "@coldmind/decorate": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^17.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "happy-dom": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "5.0.5",
    "inversify": "8.2.3",
    "tsyringe": "4.10.0",
    "awilix": "13.0.5",
    "typedoc": "0.28.20",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ]
}
