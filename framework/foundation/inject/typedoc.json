{
  "entryPoints": [
    "src/core/cminject.core.ts",
    "src/server/cminject.server.ts",
    "src/cminject.testing.ts",
    "src/cminject.inspect.ts",
    "src/cminject.react.ts"
  ],
  "out": "docs/api",
  "excludePrivate": true,
  "excludeInternal": true,
  "disableSources": true,
  "readme": "none",
  "intentionallyNotExported": [
    "UnionKeys",
    "ProvidedUnion",
    "UnionValue",
    "Unsatisfied",
    "RequiredUnion",
    "CapabilitiesOf",
    "ModuleCapabilities",
    "ModuleDeclaration",
    "ImportsOf",
    "DefinitionSnapshot",
    "CompositionCheck"
  ]
}
