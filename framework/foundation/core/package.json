{
  "name": "@coldmind/core",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Shared validation results and type utilities; no runtime dependencies.",
  "main": "./src/core.ts",
  "types": "./src/core.ts",
  "exports": {
    ".": "./src/core.ts",
    "./validation": "./src/core.validation.ts",
    "./type-utils": "./src/core.types.ts",
    "./*": "./*"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json"
  }
}
