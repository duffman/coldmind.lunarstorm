{
  "name": "@coldmind/vcl.common",
  "version": "0.1.0",
  "description": "VCL common controls: Button, Label, TextEdit, Memo, CheckBox, ListBox",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button/vcl.button.tsx",
    "./label": "./src/label/vcl.label.tsx",
    "./text": "./src/text/vcl.text.tsx",
    "./memo": "./src/memo/vcl.memo.tsx",
    "./checkbox": "./src/checkbox/vcl.checkbox.tsx",
    "./listbox": "./src/listbox/vcl.listbox.tsx",
    "./*": "./*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@coldmind/vcl.app": "workspace:*",
    "@coldmind/vcl.core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
